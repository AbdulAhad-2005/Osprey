# Where the Osprey FastAPI backend is reachable. In dev, Next proxies /api/*
# and the SSE stream to this address (see next.config.mjs) so the browser stays
# same-origin. Default matches the backend's default port.
OSPREY_API_BASE=http://localhost:9000

# Only set this for a hosted, split-origin deployment where the browser should
# call the backend directly instead of through the Next proxy. Leave unset for
# local use. Must be reachable from the browser, and the backend's
# OSPREY_CORS_ORIGINS must include this app's origin.
# NEXT_PUBLIC_API_BASE=https://osprey-api.internal.example
