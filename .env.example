ENVIRONMENT=development
POSTGRES_DB=pentest
POSTGRES_USER=pentest
POSTGRES_PASSWORD=pentest
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://pentest:pentest@postgres:5432/pentest
API_BASE_URL=http://localhost:9000
TEMPORAL_ADDRESS=localhost:7233

# LLM — Google AI Studio (recommended free tier)
# Best free model for this agent: gemini/gemini-3.5-flash (reasoning + tool calling)
# Cheaper/more quota but weaker: gemini/gemini-3.1-flash-lite
LLM_MODEL=gemini/gemini-3.5-flash
LLM_API_KEY=your-gemini-api-key-here

# LLM call settings
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=300
LLM_MAX_AGENT_TURNS=40
LLM_TOOL_TIMEOUT=900

# API (CLI connects here)
API_BASE_URL=http://localhost:9000
