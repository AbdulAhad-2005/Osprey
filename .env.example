ENVIRONMENT=development
POSTGRES_DB=pentest
POSTGRES_USER=pentest
POSTGRES_PASSWORD=<db-password>
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://pentest:<db-password>@postgres:5432/pentest
# Native/local runs without Postgres can use SQLite instead (schema auto-created):
# DATABASE_URL=sqlite:///./pentest.db

# Which container to `docker exec` tools into. Leave as-is for the `kali` compose profile
# set to your own Kali container name to bring your own tools; set empty
# to force native host execution. If the named container isn't running, the
# backend falls back to native automatically.
KALI_CONTAINER=osprey-kali

# Which image `docker compose --profile kali up` pulls for the kali-tools
# container (default: the prebuilt image published by CI to Docker Hub — see
# .github/workflows/build-kali-image.yml). Override to pin an exact tag
# (OSPREY_KALI_IMAGE=ospreytools/osprey-kali:<git-sha>) or point at your own
# mirror. Ignored if you build from source instead (docker-compose.build.yml).
# OSPREY_KALI_IMAGE=ospreytools/osprey-kali:latest

# API (CLI connects here)
API_BASE_URL=http://localhost:9000
TEMPORAL_ADDRESS=localhost:7233

# LLM — any LiteLLM provider id (openai/…, anthropic/…, gemini/…, groq/…, deepseek/…, openrouter/…, ollama/…). 
# Docker bundles the deps for the default; native + gemini/* also needs the Google SDK: 
# pip install -e ./backend[gemini].
# Required for the `cli/` operator tool (`osprey` / `python -m cli`) — it
# reads these to drive its own local agent loop directly, with your own key.
# Optional for the backend itself, which only uses its own copy for the deterministic
# `--engine` i.e. No-LLM model — the OpenCode/Claude MCP path needs neither.

LLM_MODEL=<llm-model-name>
LLM_API_KEY=<llm-api-key>
LLM_API_BASE=

# Set only if your provider's free-tier TPM cap is below the CLI's full tool catalog (~26K tokens for all ~118 tools). Unset sends all tool schemas every turn.
# When set, sends a small core plus tools fitting the budget. Unlisted tools remain reachable via platform_tools (search) and platform_exec (invoke).
# LLM_TOOL_SCHEMA_BUDGET_TOKENS=7000

# LLM call settings
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT=300
LLM_MAX_AGENT_TURNS=40
LLM_TOOL_TIMEOUT=900

# Passive OSINT (optional — enables shodan_search / shodan_host_info)
SHODAN_API_KEY=

# Credential harvesting (optional — enables intelx_scan / resecurity_scan).
# IntelX: key from https://intelx.io/account?tab=developer. INTELX_API_KEY drives
# the phonebook (email/subdomain harvest); INTELX_IDENTITY_API_KEY unlocks leaked
# account records (user+password) via the Identity API (separate licence).
INTELX_API_KEY=
INTELX_IDENTITY_API_KEY=
# Override only if your account uses a non-default API instance:
# INTELX_API_BASE=https://2.intelx.io
# INTELX_IDENTITY_BASE=https://3.intelx.io

# Resecurity: no public API contract, so this connector is configurable — set the
# key, and adjust the endpoint/param/auth to match your account's API if needed.
RESECURITY_API_KEY=
# RESECURITY_API_BASE=https://api.resecurity.com
# RESECURITY_ENDPOINT=/v1/leaks/search
# RESECURITY_QUERY_PARAM=query
# RESECURITY_AUTH_HEADER=Authorization
# RESECURITY_AUTH_SCHEME=Bearer

# domain_hunter's ai_hunt module (optional — LLM-hypothesized sister/subsidiary
# domains, DNS/live-verified before being trusted; skipped entirely if none of
# these are set). Read directly by mcp-servers/recon/tools/_domain_hunter_cli.py's
# own .env parser, not by the rest of the app's config loader.
dom_hunter_gemini_key=
dom_hunter_anthropic_key=
dom_hunter_openai_key=
# Optional — overrides the default model for whichever provider key is set
# (gemini-3.6-flash / claude-sonnet-5 / gpt-4o-mini respectively):
# dom_hunter_llm_model=

# OpenCode / platform-mcp session (optional — auto-created on first MCP call if unset)
PENTEST_ENGAGEMENT_ID=
PENTEST_TARGET=
PENTEST_API_BASE=http://localhost:9000
